{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "arrowParens": "always",
  "sortImports": true,
  // Field order in package.json files stays as written.
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/next",
    "**/.angular",
    "**/.vitest",
    ".repos",
    ".pnpm-store",
    "**/storybook-static",
    "pnpm-lock.yaml",
    // Written by release-please.
    "**/CHANGELOG.md",
    "**/region-iso-3166-codes.ts",
    "**/@dedot/api/chaintypes/substrate/tx.d.ts"
  ]
}
