{
  "name": "stakekit",
  "keywords": [
    "stakekit",
    "widget"
  ],
  "author": "Petar Todorovic <petar@omni.app> (https://github.com)",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12"
    }
  },
  "scripts": {
    "dev": "mise run dev --",
    "build": "mise run build --",
    "lint": "mise run lint --",
    "lint:ast": "mise run lint:ast --",
    "test:ast": "mise run test:ast --",
    "test": "mise run test --",
    "test:smoke": "mise run test:smoke --",
    "format": "mise run format --",
    "clean": "mise run clean --",
    "prepare": "husky && pnpm --filter @stakekit/widget exec effect-tsgo patch --typescript --no-oxlint --typescript-package @typescript/native",
    "check-hygiene": "mise run check-hygiene --",
    "check": "mise run check --"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/tsgo": "catalog:",
    "husky": "catalog:"
  }
}
