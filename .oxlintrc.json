{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "vitest",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true
  },
  "rules": {
    "default-param-last": "error",
    // Button labels sit in nested spans (button > span > span > text).
    "jsx-a11y/control-has-associated-label": ["error", { "depth": 3 }],
    // The Design System draws charts, live regions and custom listboxes that
    // keep their ARIA role; no native element renders them.
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-else-return": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "one-var": ["error", "never"],
    "react/rules-of-hooks": "error",
    "react/self-closing-comp": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-enum-initializers": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    "unicorn/prefer-number-properties": "error",
    "vitest/no-duplicate-hooks": "error",
    // Tests pass Vitest's documented second argument, a failure message.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Effect tests assert inside Effect.gen and through shared assertion
    // helpers, which the rule cannot follow.
    "vitest/expect-expect": "off",
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": [
          "it.effect",
          "it.effect.each",
          "it.effect.fails",
          "it.effect.skipIf",
          "it.live"
        ]
      }
    ],
    // Style preferences outside the checks this repo enforces.
    "vitest/no-conditional-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    // Reports `Effect.promise(() => expect.element(...))`, which returns the poll
    // to Effect.promise and awaits it there.
    "vitest/require-awaited-expect-poll": "off"
  },
  "overrides": [
    {
      "files": ["packages/examples/with-nextjs/**"],
      "plugins": ["nextjs"]
    }
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/next",
    "**/.angular",
    "**/.vitest",
    ".repos",
    ".pnpm-store",
    "**/storybook-static",
    "**/region-iso-3166-codes.ts"
  ]
}
