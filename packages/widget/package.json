{
  "name": "@stakekit/widget",
  "version": "0.0.296",
  "type": "module",
  "main": "./dist/package/index.package.js",
  "types": "./dist/types/index.package.d.ts",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.package.d.ts",
      "default": "./dist/package/index.package.js"
    },
    "./bundle": {
      "types": "./dist/types/index.bundle.d.ts",
      "default": "./dist/bundle/index.bundle.js"
    },
    "./style.css": {
      "default": "./dist/package/index.package.css"
    }
  },
  "files": [
    "dist/package",
    "dist/bundle",
    "dist/types",
    "package.json",
    "README.md",
    "!**/.*"
  ],
  "keywords": [
    "stakekit",
    "widget"
  ],
  "author": "Petar Todorovic <petar@omni.app> (https://github.com)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stakekit/widget.git"
  },
  "scripts": {
    "dev": "vite -c vite/vite.config.dev.ts",
    "start": "pnpm dev",
    "build": "pnpm clean && pnpm build:package && pnpm build:bundle && pnpm build:website && pnpm check:stylex-css && pnpm check:bundle-size && pnpm build:types && pnpm check:package-types && pnpm check:host-bundlers",
    "lint": "TSRS_FAST=1 effect-tsgo --tsrs-lint oxlint --type-check . && pnpm check:generated-schemas",
    "lint:fix": "effect-tsgo --tsrs-lint oxlint --fix .",
    "clean": "rm -rf dist",
    "preview": "vite -c vite/vite.config.dev.ts preview --outDir dist/website",
    "gen:api": "tsx scripts/generated-api/generate-effect-openapi.ts",
    "gen:yield-providers": "tsx scripts/yield-providers/generate-yield-provider-ids.ts",
    "test": "mise run test --",
    "test:unit": "vitest -c vite/vitest.config.ts --project unit --project unit-isolated run",
    "test:unit:watch": "vitest -c vite/vitest.config.ts --project unit --project unit-isolated",
    "test:dom": "vitest -c vite/vitest.config.ts --project dom run",
    "test:dom:watch": "vitest -c vite/vitest.config.ts --project dom",
    "test:browser": "vitest -c vite/vitest.config.ts --project browser run",
    "test:browser:diagnostic": "vitest -c vite/vitest.config.ts --project browser run --browser.traceView --reporter=default --reporter=html",
    "test:storybook": "vitest -c vite/vitest.config.ts --project storybook run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:changed": "vitest -c vite/vitest.config.ts run --project unit --project unit-isolated --project dom --changed",
    "test:changed:all": "vitest -c vite/vitest.config.ts run --changed",
    "test:changed:unit": "vitest -c vite/vitest.config.ts run --project unit --project unit-isolated --changed",
    "test:smoke": "tsx scripts/smoke/check-production-host-consumption.ts",
    "build:website": "vite -c vite/vite.config.website build",
    "build:package": "vite -c vite/vite.config.package.ts build",
    "build:package:watch": "vite -w -c vite/vite.config.package.ts build",
    "build:bundle": "vite -c vite/vite.config.bundle.ts build",
    "build:types": "tsc --project tsconfig.build.json && tsx scripts/declarations/emit-entry-declarations.ts",
    "check:generated-schemas": "tsx scripts/generated-api/check-generated-schemas.ts",
    "check:package-types": "tsx scripts/declarations/check-package-types.ts",
    "check:host-bundlers": "tsx scripts/host-bundlers/check-esbuild-consumption.ts",
    "check:stylex-css": "tsx scripts/styles/check-stylex-css.ts",
    "check:bundle-size": "tsx scripts/bundle-size/check-entry-size.ts",
    "check-hygiene": "pnpm check-hygiene:architecture && pnpm check-hygiene:unused && pnpm check-hygiene:production && pnpm check-hygiene:duplication && pnpm check-hygiene:test-duplication",
    "check-hygiene:architecture": "tsx scripts/architecture/check-architecture.ts",
    "check-hygiene:unused": "knip --include files,dependencies,unlisted,exports,nsExports,types,nsTypes --no-progress --treat-config-hints-as-errors",
    "check-hygiene:production": "knip --production --include files,dependencies,unlisted --no-progress --treat-config-hints-as-errors",
    "check-hygiene:duplication": "jscpd",
    "check-hygiene:test-duplication": "jscpd --config .jscpd-tests.json"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "scheduler": "catalog:"
  },
