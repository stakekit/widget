    "react-i18next": "catalog:",
    "react-loading-skeleton": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-macros": "catalog:",
    "viem": "catalog:",
    "vite": "catalog:",
    "vite-plugin-node-polyfills": "catalog:",
    "vitest": "catalog:",
